{
  "manifest_version": 3,
  "name": "Slipstream — Smart Money Overlay",
  "version": "1.0.0",
  "description": "Overlays wallet labels, PnL, win rate and risk scores on top of every address and holder on the sites you already use.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Slipstream",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": { "service_worker": "src/background.js" },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": [
        "*://*.solscan.io/*",
        "*://*.etherscan.io/*",
        "*://*.basescan.org/*",
        "*://*.bscscan.com/*",
        "*://*.arbiscan.io/*",
        "*://gmgn.ai/*",
        "*://*.gmgn.ai/*",
        "*://dexscreener.com/*",
        "*://*.dextools.io/*",
        "*://photon-sol.tinyastro.io/*",
        "*://x.com/*",
        "*://twitter.com/*"
      ],
      "js": ["src/data.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    { "resources": ["icons/*"], "matches": ["<all_urls>"] }
  ]
}
